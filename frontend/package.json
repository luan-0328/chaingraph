{
  "name": "ai-ticket-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 智能工单处理平台 —— 前端（Vue 3 + TypeScript + Element Plus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.9",
    "element-plus": "^2.9.5",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0"
  }
}
