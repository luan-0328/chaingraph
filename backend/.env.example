# ============================================================
# 智能电商客服与售后工单平台 —— 环境变量模板
# 复制成 .env 后填写：copy .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_NAME=智能电商客服与售后工单平台
APP_VERSION=2.0.0

# ---------- MySQL ----------
# 启动时会自动建库、建表、灌演示数据（dev 环境）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/shop_ticket?charset=utf8mb4

# ---------- 鉴权 ----------
# python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- LLM（对话模型，OpenAI 兼容）----------
# DeepSeek 官方：base_url=https://api.deepseek.com  模型=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=90

# ---------- Embedding（RAG 向量化）----------
# DeepSeek 不提供 embedding 接口，需要单独配置一个 OpenAI 兼容的 embedding 服务。
# 留空时：RAG 会自动降级为本地轻量向量器（哈希向量 + 余弦），链路照样能跑，
#         但语义检索效果弱。填上 key 后无需改代码，重启即用真 embedding。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# 只用于诊断显示；**检索实际用的是向量本身的长度**，配错不会影响检索
EMBEDDING_DIM=

# ---------- 向量库（RAG 检索后端）----------
# qdrant = 用 Qdrant 存向量索引并做 ANN 检索（默认）
# mysql  = 旧实现（向量存 knowledge_chunks，检索时全量 numpy 余弦）—— 作为回退保留
# 无论选哪个，分块正文与向量都写在 MySQL（真相源），Qdrant 里的那份随时可重建：
#   POST /api/admin/knowledge/reindex  只搬向量不重算 Embedding
VECTOR_STORE=qdrant

# Qdrant 地址。留空 = **本地内嵌模式**：数据落在 QDRANT_PATH，不用起服务；
# 但同一目录同一时刻只能被一个进程打开（pytest 会同时拉起多个实例，
# 那时只有第一个用得上 Qdrant，其余会按设计回退到 MySQL 并在日志里 WARNING）。
QDRANT_URL=
# 多实例 / 生产请起服务端，然后把 QDRANT_URL 指过去：
#   docker run -d --name qdrant -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
#   QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=knowledge_chunks
QDRANT_TIMEOUT=15

# ---------- 业务规则 ----------
# 售后自动退款金额上限（超过必须人工审批）
REFUND_AUTO_APPROVE_LIMIT=500
# 物流超过多少小时没更新算异常
LOGISTICS_STALLED_HOURS=72
# Agent 自动重试次数（只对可恢复异常重试：超时/429/依赖抖动）
AGENT_MAX_RETRIES=2
# 中途失败要不要复用 Checkpoint 断点续跑（已跑完的只读节点不重跑）。
# 关掉就退化成"整图重跑"，功能正常但更慢、更费 token。
AGENT_RESUME_FROM_CHECKPOINT=true

# ---------- 测试专用（正常启动不要打开）----------
# 打开后：用确定性 LLM 桩替换模型调用（固定耗时、不花钱、行为可登记），
# 并挂载无鉴权的 /api/__test__/*（登记哪张工单走 HITL / 给节点注入故障）。
# pytest 与 scripts/concurrency_check.py 会自己拉起这样的实例，不需要你手动配。
# AGENT_STUB_LLM=1
# AGENT_STUB_DELAY_SECONDS=1.0        # 每次"模型调用"的固定耗时，用来撑开并发窗口
# AGENT_STUB_BUSINESS_ACTION=         # 空=只给结论不动业务；apply_refund=真的走退款链路

# ---------- 文件 ----------
# Checkpoint 持久化文件（SQLite），用于 Agent 暂停/恢复
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
AGENT_MAX_CONCURRENCY=4
AGENT_LEASE_SECONDS=120
AGENT_HEARTBEAT_SECONDS=15
AGENT_POLL_SECONDS=1
# 审批提醒与过期均由 worker 扫描；超时只转人工，不自动批准或退款。
AGENT_REVIEW_REMINDER_SECONDS=3600
AGENT_REVIEW_TIMEOUT_SECONDS=86400

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 工单图片（阿里云 OSS 私有桶）----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_MAX_UPLOAD_BYTES=5242880
OSS_SIGNED_URL_SECONDS=300

# RAG 检索参数：按 Embedding 模型在开发集校准，不同模型不能共用相似度阈值。
# 本轮实验候选为 Top K=6、阈值0.55，但域内未知问题拒检仍不足，暂保留原默认。
RAG_TOP_K=4
RAG_MIN_SCORE=0.05
