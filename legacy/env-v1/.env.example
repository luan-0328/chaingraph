# ============================================================
# AI 智能工单处理平台 —— 环境变量模板
# 用法：复制成 .env 后填写自己的值
#       Windows:  copy .env.example .env
#       macOS/Linux: cp .env.example .env
# .env 已经被 .gitignore 忽略，不会被提交。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev

# ---------- MySQL ----------
# 启动时会自动建库 ai_ticket、建表、并在 dev 环境灌一份演示数据
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_ticket
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---------- LLM（OpenAI 兼容协议）----------
# 以 DeepSeek 官方文档为准（2026-09 核实）：
#   base_url  = https://api.deepseek.com
#   模型名     = deepseek-flash（推荐）或 deepseek-v4-pro
#   注意：旧模型名 deepseek-v4-flash 已下线，不要再使用。
# 没有 Key 就没有降级逻辑了，调用 Agent 会直接失败。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 分析类任务，温度给 0 更稳定
LLM_TEMPERATURE=0.0
# 单次请求超时（秒）
LLM_TIMEOUT=60

# ---------- 鉴权（JWT） ----------
# 登录成功后签发的令牌用它签名；泄露 = 别人可以伪造登录票据，生产环境务必换掉。
# 生成方法：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720

# ---------- 前端 CORS（逗号分隔） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------- 业务规则阈值 ----------
# 退款金额超过这个数必须人工审核（开发文档 §20）
REFUND_HUMAN_REVIEW_THRESHOLD=500

# ---------- 后续阶段才会用到（现在不要填、也不用管）----------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-ticket-agent
